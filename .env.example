# Supabase : le transport des sessions partagées (Realtime), les comptes et les
# tableaux hébergés (base + Storage). Sans ces valeurs, tout fonctionne en local :
# les sessions passent en pair-à-pair et le bouton « Se connecter » reste éteint.
# Ces deux valeurs se trouvent dans le tableau de bord Supabase, sous Settings → API.
# La clé anonyme est publique : elle part dans le site construit, c'est prévu ainsi.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
